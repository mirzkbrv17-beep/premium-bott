# Muhit: dev | test | prod
ENV=dev
DATABASE_URL=postgresql://abu:abu_dev_pass@localhost:5432/abu_bot
# Majburiy (prod): kuchli tasodifiy qiymat
SECRET_KEY=change-me-to-a-long-random-string
# Telegram
BOT_TOKEN=
BOT_USERNAME=premiumabu_bot
WEBAPP_URL=https://your-app.onrender.com
WEBHOOK_SECRET=change-me-random
ADMIN_TELEGRAM_IDS=123456789
SUPPORT_USERNAME=@your_support
# Qo'lda karta to'lovi (rekvizit matni)
MANUAL_CARD_INFO=Karta: 8600 **** **** ****  (Ism Familiya)
# Click (sandbox/merchant ma'lumotlari kelganda)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_MERCHANT_USER_ID=
CLICK_SECRET_KEY=
# Faqat dev/test
MOCK_PROVIDER_ENABLED=false
MOCK_WEBHOOK_SECRET=mock-secret
RUN_SCHEDULER=true
CORS_ORIGINS=
